# Source this from the project root to point host-side scripts at the published
# worker ports:
#
#     source local/.env.local
#
# These are the same variable names the in-container coordinator reads, so one
# set of exports works for local/http_client.py, local/quack_client.py,
# app/related_cluster_sql.py and app/quack_pattern_demo.py.
#
# This file is NOT read by docker compose - it only affects your host shell.

export QUACK_TOKEN=local-dev-token

export WORKER_1_ENDPOINT=localhost:9491
export WORKER_2_ENDPOINT=localhost:9492
export WORKER_3_ENDPOINT=localhost:9493

# Uncomment to run the existing coordinator scripts from the host in Quack mode.
# export SERVER_MODE=quack
